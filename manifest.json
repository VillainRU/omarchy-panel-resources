{
  "schemaVersion": 1,
  "id": "io.github.villainru.panel-resources",
  "name": "Panel Resources",
  "version": "0.2.0",
  "author": "VillainRU",
  "license": "MIT",
  "description": "Selectable CPU, memory, disk and GPU sensors for the Omarchy QuickShell bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Panel Resources",
    "description": "Show selected system and GPU sensors on the bar.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 2
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 2
      }
    ]
  }
}
