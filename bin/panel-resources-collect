#!/usr/bin/env bash

set -u

watch_mode=false
control_mode=false
panel_open=false
interval_ms=2000
enabled_metrics_csv=""
enabled_filter_set=false
rescan_interval_sec=600

while (( $# > 0 )); do
  case "$1" in
    --watch) watch_mode=true ;;
    --control) control_mode=true ;;
    --interval-ms)
      shift
      (( $# > 0 )) || { printf 'missing --interval-ms value\n' >&2; exit 64; }
      interval_ms=$1
      ;;
    --enabled-metrics)
      shift
      (( $# > 0 )) || { printf 'missing --enabled-metrics value\n' >&2; exit 64; }
      enabled_metrics_csv=$1
      enabled_filter_set=true
      ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 64 ;;
  esac
  shift
done

[[ $interval_ms =~ ^[0-9]+$ ]] || interval_ms=2000
(( interval_ms < 1000 )) && interval_ms=1000
(( interval_ms > 30000 )) && interval_ms=30000
printf -v interval_delay '%d.%03d' "$((interval_ms / 1000))" "$((interval_ms % 1000))"

requested_locale=${PANEL_RESOURCES_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}
case "$requested_locale" in
  [rR][uU]|[rR][uU][_.@-]*) language="ru" ;;
  *) language="en" ;;
esac
export LC_ALL=C

MAX_METRICS=16
MAX_DEPENDENCIES=8
MAX_OUTPUT_BYTES=8192

declare -A enabled_metrics=()
declare -a metrics=()
declare -A metric_ids=()
declare -a dependencies=()
declare -A dependency_ids=()
declare -a cpu_frequency_paths=()
declare -A metric_metadata=()

if [[ $enabled_filter_set == true && -n $enabled_metrics_csv ]]; then
  IFS=',' read -r -a requested_ids <<< "$enabled_metrics_csv"
  for requested_id in "${requested_ids[@]}"; do
    case "$requested_id" in
      cpu.load|cpu.temp|cpu.power|cpu.frequency|memory.ram|memory.swap|disk.root|gpu.load|gpu.temp|gpu.edge|gpu.hotspot|gpu.memory_temp|gpu.power|gpu.fan|gpu.frequency|gpu.vram)
        enabled_metrics[$requested_id]=1
        ;;
    esac
  done
fi

if [[ $language == ru ]]; then
  label_cpu_load="Загрузка процессора"; detail_cpu_load="Суммарная загрузка всех ядер"
  label_cpu_temp="Температура процессора"; label_cpu_power="Потребление процессора"
  label_cpu_frequency="Средняя частота CPU"; detail_cpu_frequency="Среднее по активным политикам cpufreq"
  label_memory="Оперативная память"; label_swap="Файл подкачки"; label_disk="Системный диск"
  label_gpu_load="Загрузка видеокарты"; label_gpu_temp="Температура GPU"
  label_gpu_hotspot="GPU Hotspot"; label_gpu_memory_temp="Температура видеопамяти"
  label_gpu_power="Потребление видеокарты"; label_gpu_fan="Вентилятор видеокарты"
  label_gpu_frequency="Частота видеокарты"; label_vram="Видеопамять"
else
  label_cpu_load="CPU load"; detail_cpu_load="Combined load across all cores"
  label_cpu_temp="CPU temperature"; label_cpu_power="CPU power"
  label_cpu_frequency="Average CPU frequency"; detail_cpu_frequency="Average across active cpufreq policies"
  label_memory="Memory"; label_swap="Swap"; label_disk="System disk"
  label_gpu_load="GPU load"; label_gpu_temp="GPU temperature"
  label_gpu_hotspot="GPU Hotspot"; label_gpu_memory_temp="VRAM temperature"
  label_gpu_power="GPU power"; label_gpu_fan="GPU fan"
  label_gpu_frequency="GPU frequency"; label_vram="VRAM"
fi

trim_into() {
  local output_name=$1 value=${2-}
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf -v "$output_name" '%s' "$value"
}

sanitize_text_into() {
  local output_name=$1 value=${2-} max_length=${3:-64}
  local raw_limit=$((max_length * 4)) clean="" char index
  (( ${#value} > raw_limit )) && value=${value:0:raw_limit}
  for ((index = 0; index < ${#value} && ${#clean} < max_length; index++)); do
    char=${value:index:1}
    [[ $char == [[:cntrl:]] ]] && continue
    case "$char" in '<'|'>'|'&') continue ;; esac
    clean+=$char
  done
  trim_into clean "$clean"
  printf -v "$output_name" '%s' "$clean"
}

json_escape_into() {
  local output_name=$1 value=${2-}
  value=${value//\\/\\\\}; value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}; value=${value//$'\r'/}
  printf -v "$output_name" '%s' "$value"
}

read_number_into() {
  local output_name=$1 path=$2 value
  [[ -r $path ]] || return 1
  IFS= read -r value < "$path" || return 1
  [[ $value =~ ^-?[0-9]+([.][0-9]+)?$ ]] || return 1
  printf -v "$output_name" '%s' "$value"
}

format_gib_into() {
  local output_name=$1 bytes=$2 tenths
  [[ $bytes =~ ^[0-9]+$ ]] || return 1
  tenths=$(((bytes * 10 + 536870912) / 1073741824))
  printf -v "$output_name" '%d.%d GiB' "$((tenths / 10))" "$((tenths % 10))"
}

metric_requested() {
  local id=$1 collect_all_value=$2
  [[ $collect_all_value == true || -n ${enabled_metrics[$id]+x} ]]
}

add_metric() {
  local id=$1 kind=$2 label=$3 short_label=$4 value=$5 detail=${6-}
  local expected_kind safe_label safe_short safe_value safe_detail
  local escaped_id escaped_kind escaped_label escaped_short escaped_value escaped_detail item
  case "$id" in
    cpu.load|cpu.temp|cpu.power|cpu.frequency|memory.ram|memory.swap|disk.root) expected_kind="system" ;;
    gpu.load|gpu.temp|gpu.edge|gpu.hotspot|gpu.memory_temp|gpu.power|gpu.fan|gpu.frequency|gpu.vram) expected_kind="gpu" ;;
    *) return 0 ;;
  esac
  [[ $kind == "$expected_kind" && -z ${metric_ids[$id]+x} ]] || return 0
  (( ${#metrics[@]} < MAX_METRICS )) || return 0
  if [[ -z ${metric_metadata[$id]+x} ]]; then
    sanitize_text_into safe_label "$label" 64
    sanitize_text_into safe_short "$short_label" 12
    json_escape_into escaped_label "$safe_label"; json_escape_into escaped_short "$safe_short"
    metric_metadata[$id]="\"label\":\"$escaped_label\",\"shortLabel\":\"$escaped_short\""
  fi
  sanitize_text_into safe_value "$value" 16
  sanitize_text_into safe_detail "$detail" 96
  [[ -n $safe_value ]] || return 0
  json_escape_into escaped_id "$id"; json_escape_into escaped_kind "$kind"
  json_escape_into escaped_value "$safe_value"; json_escape_into escaped_detail "$safe_detail"
  if [[ $emit_complete == true || -z ${known_metric_ids[$id]+x} ]]; then
    printf -v item '{"id":"%s","kind":"%s",%s,"value":"%s","detail":"%s"}' \
      "$escaped_id" "$escaped_kind" "${metric_metadata[$id]}" "$escaped_value" "$escaped_detail"
    known_metric_ids[$id]=1
  else
    printf -v item '{"id":"%s","value":"%s","detail":"%s"}' "$escaped_id" "$escaped_value" "$escaped_detail"
  fi
  metric_ids[$id]=1
  metrics+=("$item")
}

add_dependency() {
  local id=$1 installed=$2 item
  case "$id" in linux.hwmon|btop|zenpower|k10temp|coretemp|amdgpu|amdgpu_top|nvidia|nvtop) ;; *) return 0 ;; esac
  [[ $installed == true || $installed == false ]] || return 0
  [[ -z ${dependency_ids[$id]+x} ]] || return 0
  (( ${#dependencies[@]} < MAX_DEPENDENCIES )) || return 0
  printf -v item '{"id":"%s","installed":%s}' "$id" "$installed"
  dependency_ids[$id]=1
  dependencies+=("$item")
}

read_cpu_totals_into() {
  local total_name=$1 idle_name=$2 cpu user nice system idle iowait irq softirq steal guest guest_nice
  read -r cpu user nice system idle iowait irq softirq steal guest guest_nice < /proc/stat || return 1
  printf -v "$total_name" '%s' "$((user + nice + system + idle + iowait + irq + softirq + steal))"
  printf -v "$idle_name" '%s' "$((idle + iowait))"
}

reset_detection() {
  metric_metadata=(); known_metric_ids=()
  disk_sample_second=-30; disk_cached_value=""; disk_cached_detail=""
  dependencies=(); dependency_ids=(); cpu_frequency_paths=()
  cpu_temp_path=""; cpu_temp_detail=""; cpu_power_path_primary=""; cpu_power_path_secondary=""; cpu_power_detail=""
  gpu_vendor="none"; gpu_tool=""; gpu_name=""; gpu_card=""; gpu_device=""; gpu_hwmon=""
  gpu_edge_path=""; gpu_edge_detail=""; gpu_hotspot_path=""; gpu_hotspot_detail=""
  gpu_memory_temp_path=""; gpu_memory_temp_detail=""; gpu_power_path=""; gpu_fan_path=""
  gpu_pwm_path=""; gpu_pwm_max_path=""; gpu_frequency_path=""; gpu_vram_total_path=""; gpu_vram_used_path=""
  nvidia_smi_available=false
}

discover_cpu() {
  local hwmon hwmon_name input label_path sensor_label lower_label priority
  local best_priority=999 raw_power value_path core_path="" soc_path=""
  local cpu_sensor_dependency="" cpu_vendor=""
  for hwmon in /sys/class/hwmon/hwmon*; do
    [[ -d $hwmon ]] || continue
    hwmon_name=""; [[ -r "$hwmon/name" ]] && IFS= read -r hwmon_name < "$hwmon/name"
    case "$hwmon_name" in
      zenpower) cpu_sensor_dependency="zenpower" ;;
      k10temp) [[ $cpu_sensor_dependency != zenpower ]] && cpu_sensor_dependency="k10temp" ;;
      coretemp) [[ -z $cpu_sensor_dependency ]] && cpu_sensor_dependency="coretemp" ;;
    esac
    for input in "$hwmon"/temp*_input; do
      [[ -r $input ]] || continue
      label_path=${input%_input}_label; sensor_label=""
      [[ -r $label_path ]] && IFS= read -r sensor_label < "$label_path"
      lower_label=${sensor_label,,}; priority=999
      case "$lower_label" in
        tdie) priority=1 ;; "package id 0") priority=2 ;; tctl) priority=3 ;;
        cputin|"cpu temp"|"cpu temperature") priority=4 ;; tccd1) priority=5 ;;
      esac
      if [[ $hwmon_name == coretemp || $hwmon_name == k10temp || $hwmon_name == zenpower ]]; then
        (( priority > 20 )) && priority=20
      fi
      if (( priority < best_priority )); then
        best_priority=$priority; cpu_temp_path=$input; cpu_temp_detail=${sensor_label:-$hwmon_name}
      fi
    done
    for label_path in "$hwmon"/power*_label; do
      [[ -r $label_path ]] || continue
      IFS= read -r sensor_label < "$label_path"; lower_label=${sensor_label,,}
      value_path=${label_path%_label}_input; [[ -r $value_path ]] || continue
      if [[ $hwmon_name == zenpower ]]; then
        case "$lower_label" in svi2_p_core) core_path=$value_path ;; svi2_p_soc) soc_path=$value_path ;; esac
      elif [[ $hwmon_name != amdgpu && -z $cpu_power_path_primary ]]; then
        case "$lower_label" in
          *package*|cpu*|*socket*|ppt*)
            value_path=${label_path%_label}_average; [[ -r $value_path ]] || value_path=${label_path%_label}_input
            if read_number_into raw_power "$value_path" && [[ $raw_power =~ ^[0-9]+$ ]] && (( raw_power > 0 )); then
              cpu_power_path_primary=$value_path; cpu_power_detail="$hwmon_name · $sensor_label"
            fi
            ;;
        esac
      fi
    done
  done
  if [[ -n $core_path ]]; then
    cpu_power_path_primary=$core_path; cpu_power_path_secondary=$soc_path; cpu_power_detail="zenpower · SVI2 Core"
    [[ -n $soc_path ]] && cpu_power_detail="zenpower · SVI2 Core + SoC"
  fi
  for value_path in /sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq; do
    [[ -r $value_path ]] && cpu_frequency_paths+=("$value_path")
  done
  [[ -n $cpu_sensor_dependency ]] && add_dependency "$cpu_sensor_dependency" true
  while IFS=: read -r sensor_label value_path; do
    if [[ $sensor_label =~ ^vendor_id[[:space:]]*$ ]]; then trim_into cpu_vendor "$value_path"; break; fi
  done < /proc/cpuinfo
  if [[ $cpu_vendor == AuthenticAMD && $cpu_sensor_dependency != zenpower && -z $cpu_power_path_primary ]]; then
    add_dependency "zenpower" false
  elif [[ $cpu_vendor == GenuineIntel && $cpu_sensor_dependency != coretemp ]]; then
    add_dependency "coretemp" false
  fi
}

discover_gpu() {
  local card vendor_id name label_path sensor_label lower_label input_path
  for card in /sys/class/drm/card[0-9]*; do
    [[ -r "$card/device/vendor" ]] || continue
    IFS= read -r vendor_id < "$card/device/vendor"
    case "$vendor_id" in
      0x1002) gpu_vendor="amd"; gpu_tool="amdgpu_top"; gpu_name="AMD GPU"; gpu_card=$card; break ;;
      0x10de) gpu_vendor="nvidia"; gpu_tool="nvtop"; gpu_name="NVIDIA GPU"; gpu_card=$card; break ;;
    esac
  done
  if [[ $gpu_vendor == amd ]]; then
    gpu_device=$(realpath "$gpu_card/device" 2>/dev/null || true)
    for gpu_hwmon in "$gpu_device"/hwmon/hwmon*; do
      [[ -d $gpu_hwmon ]] || continue
      name=""; [[ -r "$gpu_hwmon/name" ]] && IFS= read -r name < "$gpu_hwmon/name"
      [[ $name == amdgpu ]] && break
      gpu_hwmon=""
    done
    if [[ -n $gpu_hwmon ]]; then
      for label_path in "$gpu_hwmon"/temp*_label; do
        [[ -r $label_path ]] || continue
        IFS= read -r sensor_label < "$label_path"; input_path=${label_path%_label}_input
        [[ -r $input_path ]] || continue
        lower_label=${sensor_label,,}
        case "$lower_label" in
          edge|gpu) gpu_edge_path=$input_path; gpu_edge_detail=$sensor_label ;;
          junction|hotspot|"gpu hotspot") gpu_hotspot_path=$input_path; gpu_hotspot_detail=$sensor_label ;;
          mem|memory|vram) gpu_memory_temp_path=$input_path; gpu_memory_temp_detail=$sensor_label ;;
        esac
      done
      [[ -r "$gpu_hwmon/power1_average" ]] && gpu_power_path="$gpu_hwmon/power1_average"
      [[ -z $gpu_power_path && -r "$gpu_hwmon/power1_input" ]] && gpu_power_path="$gpu_hwmon/power1_input"
      [[ -r "$gpu_hwmon/fan1_input" ]] && gpu_fan_path="$gpu_hwmon/fan1_input"
      if [[ -z $gpu_fan_path && -r "$gpu_hwmon/pwm1" && -r "$gpu_hwmon/pwm1_max" ]]; then
        gpu_pwm_path="$gpu_hwmon/pwm1"; gpu_pwm_max_path="$gpu_hwmon/pwm1_max"
      fi
      [[ -r "$gpu_hwmon/freq1_input" ]] && gpu_frequency_path="$gpu_hwmon/freq1_input"
    fi
    [[ -r "$gpu_device/mem_info_vram_total" ]] && gpu_vram_total_path="$gpu_device/mem_info_vram_total"
    [[ -r "$gpu_device/mem_info_vram_used" ]] && gpu_vram_used_path="$gpu_device/mem_info_vram_used"
    [[ -d /sys/module/amdgpu ]] && add_dependency "amdgpu" true || add_dependency "amdgpu" false
    command -v amdgpu_top >/dev/null 2>&1 && add_dependency "amdgpu_top" true || add_dependency "amdgpu_top" false
  elif [[ $gpu_vendor == nvidia ]]; then
    if [[ -d /sys/module/nvidia ]] && command -v nvidia-smi >/dev/null 2>&1; then
      nvidia_smi_available=true; add_dependency "nvidia" true
    else
      add_dependency "nvidia" false
    fi
    command -v nvtop >/dev/null 2>&1 && add_dependency "nvtop" true || add_dependency "nvtop" false
  fi
}

discover_hardware() {
  reset_detection
  [[ -d /sys/class/hwmon ]] && add_dependency "linux.hwmon" true || add_dependency "linux.hwmon" false
  command -v btop >/dev/null 2>&1 && add_dependency "btop" true || add_dependency "btop" false
  discover_cpu; discover_gpu; last_detection_second=$SECONDS
}

nvidia_stream_fd=""; nvidia_stream_pid=""
stop_nvidia_stream() {
  if [[ -n $nvidia_stream_pid ]]; then
    kill "$nvidia_stream_pid" 2>/dev/null || true
    wait "$nvidia_stream_pid" 2>/dev/null || true
  fi
  nvidia_stream_fd=""; nvidia_stream_pid=""
}
start_nvidia_stream() {
  stop_nvidia_stream
  [[ $watch_mode == true && $gpu_vendor == nvidia && $nvidia_smi_available == true ]] || return 0
  coproc NVIDIA_STREAM {
    exec nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw,fan.speed,clocks.current.graphics \
      --format=csv,noheader,nounits --id=0 --loop-ms="$interval_ms" 2>/dev/null
  }
  nvidia_stream_fd=${NVIDIA_STREAM[0]}; nvidia_stream_pid=$NVIDIA_STREAM_PID
}
trap stop_nvidia_stream EXIT
trap 'exit 0' TERM INT

nvidia_metrics_requested() {
  local id
  for id in gpu.load gpu.temp gpu.vram gpu.power gpu.fan gpu.frequency; do
    [[ -n ${enabled_metrics[$id]+x} ]] && return 0
  done
  return 1
}

stop_unused_nvidia_stream() {
  if [[ $watch_mode == true && $gpu_vendor == nvidia && $panel_open == false && $enabled_filter_set == true ]] && ! nvidia_metrics_requested; then
    stop_nvidia_stream
  fi
}

read_nvidia_line() {
  local output_name=$1 query_line="" newer_line="" drain_count=0
  if [[ $watch_mode == true ]]; then
    [[ -n $nvidia_stream_fd ]] || return 1
    IFS= read -r -t 2 query_line <&"$nvidia_stream_fd" || return 1
    # Read the newest buffered sample after a delayed iteration, not an old
    # backlog. Bound the drain so a noisy child cannot starve system metrics.
    while (( drain_count < 8 )) && IFS= read -r -t 0.001 newer_line <&"$nvidia_stream_fd"; do
      query_line=$newer_line; drain_count=$((drain_count + 1))
    done
  else
    IFS= read -r query_line < <(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total,power.draw,fan.speed,clocks.current.graphics \
      --format=csv,noheader,nounits --id=0 2>/dev/null) || return 1
  fi
  (( ${#query_line} <= 1024 )) || return 1
  printf -v "$output_name" '%s' "$query_line"
}

add_temperature_metric() {
  local id=$1 label=$2 short_label=$3 path=$4 detail=$5 raw_temp
  read_number_into raw_temp "$path" || { needs_rescan=true; return 0; }
  (( raw_temp > 0 )) && add_metric "$id" "gpu" "$label" "$short_label" "$((raw_temp / 1000))°C" "$detail"
}

collect_nvidia_metrics() {
  local line n_load n_temp n_mem_used n_mem_total n_power n_fan n_clock
  local vram_percent used_mib total_mib used_tenths total_tenths vram_detail power_integer
  read_nvidia_line line || { needs_rescan=true; return 0; }
  IFS=',' read -r n_load n_temp n_mem_used n_mem_total n_power n_fan n_clock <<< "$line"
  trim_into n_load "$n_load"; trim_into n_temp "$n_temp"; trim_into n_mem_used "$n_mem_used"
  trim_into n_mem_total "$n_mem_total"; trim_into n_power "$n_power"; trim_into n_fan "$n_fan"; trim_into n_clock "$n_clock"
  metric_requested "gpu.load" "$collect_all" && [[ $n_load =~ ^[0-9]+([.][0-9]+)?$ ]] \
    && add_metric "gpu.load" "gpu" "$label_gpu_load" "GPU" "${n_load%.*}%" "NVML"
  metric_requested "gpu.temp" "$collect_all" && [[ $n_temp =~ ^[0-9]+([.][0-9]+)?$ ]] \
    && add_metric "gpu.temp" "gpu" "$label_gpu_temp" "GPU°" "${n_temp%.*}°C" "NVML"
  if metric_requested "gpu.vram" "$collect_all" && [[ $n_mem_used =~ ^[0-9]+([.][0-9]+)?$ && $n_mem_total =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    used_mib=${n_mem_used%.*}; total_mib=${n_mem_total%.*}
    if (( total_mib > 0 )); then
      vram_percent=$(((used_mib * 100 + total_mib / 2) / total_mib))
      used_tenths=$(((used_mib * 10 + 512) / 1024)); total_tenths=$(((total_mib * 10 + 512) / 1024))
      printf -v vram_detail '%d.%d GiB / %d.%d GiB' \
        "$((used_tenths / 10))" "$((used_tenths % 10))" "$((total_tenths / 10))" "$((total_tenths % 10))"
      add_metric "gpu.vram" "gpu" "$label_vram" "VRAM" "${vram_percent}%" "$vram_detail"
    fi
  fi
  if metric_requested "gpu.power" "$collect_all" && [[ $n_power =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    power_integer=${n_power%.*}; add_metric "gpu.power" "gpu" "$label_gpu_power" "GPU W" "${power_integer}W" "NVML"
  fi
  metric_requested "gpu.fan" "$collect_all" && [[ $n_fan =~ ^[0-9]+([.][0-9]+)?$ ]] \
    && add_metric "gpu.fan" "gpu" "$label_gpu_fan" "FAN" "${n_fan%.*}%" "NVML"
  metric_requested "gpu.frequency" "$collect_all" && [[ $n_clock =~ ^[0-9]+([.][0-9]+)?$ ]] \
    && add_metric "gpu.frequency" "gpu" "$label_gpu_frequency" "GPU↯" "${n_clock%.*}MHz" "NVML"
}

collect_snapshot() {
  collect_all=$1
  metrics=(); metric_ids=(); needs_rescan=false
  local cpu_total cpu_idle cpu_delta cpu_idle_delta cpu_usage raw_value secondary_value power_total
  local freq_sum=0 freq_count=0 avg_mhz tenths value_text
  local mem_total_kib=0 mem_available_kib=0 swap_total_kib=0 swap_free_kib=0 key value
  local used_kib percent used_text total_text disk_total disk_used disk_available disk_percent
  local gpu_load pwm pwm_max vram_total vram_used
  if metric_requested "cpu.load" "$collect_all" && read_cpu_totals_into cpu_total cpu_idle; then
    if [[ -n ${previous_cpu_total:-} ]]; then
      cpu_delta=$((cpu_total - previous_cpu_total)); cpu_idle_delta=$((cpu_idle - previous_cpu_idle))
      if (( cpu_delta > 0 )); then
        cpu_usage=$((((cpu_delta - cpu_idle_delta) * 100 + cpu_delta / 2) / cpu_delta))
        add_metric "cpu.load" "system" "$label_cpu_load" "CPU" "${cpu_usage}%" "$detail_cpu_load"
      fi
    fi
    previous_cpu_total=$cpu_total; previous_cpu_idle=$cpu_idle
  fi
  if metric_requested "cpu.temp" "$collect_all" && [[ -n $cpu_temp_path ]]; then
    if read_number_into raw_value "$cpu_temp_path"; then
      (( raw_value > 0 )) && add_metric "cpu.temp" "system" "$label_cpu_temp" "CPU°" "$((raw_value / 1000))°C" "$cpu_temp_detail"
    else needs_rescan=true; fi
  fi
  if metric_requested "cpu.power" "$collect_all" && [[ -n $cpu_power_path_primary ]]; then
    if read_number_into raw_value "$cpu_power_path_primary"; then
      power_total=$raw_value
      if [[ -n $cpu_power_path_secondary ]]; then
        if read_number_into secondary_value "$cpu_power_path_secondary"; then power_total=$((power_total + secondary_value)); else needs_rescan=true; fi
      fi
      add_metric "cpu.power" "system" "$label_cpu_power" "CPU W" "$(((power_total + 500000) / 1000000))W" "$cpu_power_detail"
    else needs_rescan=true; fi
  fi
  if metric_requested "cpu.frequency" "$collect_all" && (( ${#cpu_frequency_paths[@]} > 0 )); then
    for value in "${cpu_frequency_paths[@]}"; do
      if read_number_into raw_value "$value"; then freq_sum=$((freq_sum + raw_value)); freq_count=$((freq_count + 1)); else needs_rescan=true; fi
    done
    if (( freq_count > 0 )); then
      avg_mhz=$((freq_sum / freq_count / 1000))
      if (( avg_mhz >= 1000 )); then
        tenths=$(((avg_mhz + 50) / 100)); printf -v value_text '%d.%dGHz' "$((tenths / 10))" "$((tenths % 10))"
      else printf -v value_text '%dMHz' "$avg_mhz"; fi
      add_metric "cpu.frequency" "system" "$label_cpu_frequency" "CPU↯" "$value_text" "$detail_cpu_frequency"
    fi
  fi
  if metric_requested "memory.ram" "$collect_all" || metric_requested "memory.swap" "$collect_all"; then
    while read -r key value _; do
      case "$key" in MemTotal:) mem_total_kib=$value ;; MemAvailable:) mem_available_kib=$value ;; SwapTotal:) swap_total_kib=$value ;; SwapFree:) swap_free_kib=$value ;; esac
    done < /proc/meminfo
  fi
  if metric_requested "memory.ram" "$collect_all" && (( mem_total_kib > 0 )); then
    used_kib=$((mem_total_kib - mem_available_kib)); percent=$((used_kib * 100 / mem_total_kib))
    format_gib_into used_text "$((used_kib * 1024))"; format_gib_into total_text "$((mem_total_kib * 1024))"
    add_metric "memory.ram" "system" "$label_memory" "RAM" "${percent}%" "$used_text / $total_text"
  fi
  if metric_requested "memory.swap" "$collect_all" && (( swap_total_kib > 0 )); then
    used_kib=$((swap_total_kib - swap_free_kib)); percent=$((used_kib * 100 / swap_total_kib))
    format_gib_into used_text "$((used_kib * 1024))"; format_gib_into total_text "$((swap_total_kib * 1024))"
    add_metric "memory.swap" "system" "$label_swap" "SWP" "${percent}%" "$used_text / $total_text"
  fi
  if metric_requested "disk.root" "$collect_all"; then
    if (( SECONDS - disk_sample_second >= 30 )); then
      disk_sample_second=$SECONDS; disk_cached_value=""; disk_cached_detail=""
      { read -r _; read -r _ disk_total disk_used disk_available disk_percent _; } < <(df -P -B1 / 2>/dev/null)
      if [[ ${disk_total:-0} =~ ^[0-9]+$ ]] && (( disk_total > 0 )); then
        format_gib_into used_text "$disk_used"; format_gib_into total_text "$disk_total"
        disk_cached_value=$disk_percent; disk_cached_detail="$used_text / $total_text"
      fi
    fi
    [[ -n $disk_cached_value ]] && add_metric "disk.root" "system" "$label_disk" "SSD" "$disk_cached_value" "$disk_cached_detail"
  fi
  if [[ $gpu_vendor == amd && -n $gpu_device ]]; then
    [[ -d $gpu_device ]] || needs_rescan=true
    if metric_requested "gpu.load" "$collect_all" && [[ -r "$gpu_device/gpu_busy_percent" ]]; then
      read_number_into gpu_load "$gpu_device/gpu_busy_percent" && add_metric "gpu.load" "gpu" "$label_gpu_load" "GPU" "${gpu_load}%" "amdgpu · gpu_busy_percent"
    fi
    metric_requested "gpu.edge" "$collect_all" && [[ -n $gpu_edge_path ]] && add_temperature_metric "gpu.edge" "$label_gpu_temp" "EDGE" "$gpu_edge_path" "$gpu_edge_detail"
    metric_requested "gpu.hotspot" "$collect_all" && [[ -n $gpu_hotspot_path ]] && add_temperature_metric "gpu.hotspot" "$label_gpu_hotspot" "HOT" "$gpu_hotspot_path" "$gpu_hotspot_detail"
    metric_requested "gpu.memory_temp" "$collect_all" && [[ -n $gpu_memory_temp_path ]] && add_temperature_metric "gpu.memory_temp" "$label_gpu_memory_temp" "MEM°" "$gpu_memory_temp_path" "$gpu_memory_temp_detail"
    if metric_requested "gpu.power" "$collect_all" && [[ -n $gpu_power_path ]]; then
      if read_number_into raw_value "$gpu_power_path"; then add_metric "gpu.power" "gpu" "$label_gpu_power" "GPU W" "$(((raw_value + 500000) / 1000000))W" "PPT"; else needs_rescan=true; fi
    fi
    if metric_requested "gpu.fan" "$collect_all"; then
      if [[ -n $gpu_fan_path ]]; then
        read_number_into raw_value "$gpu_fan_path" && add_metric "gpu.fan" "gpu" "$label_gpu_fan" "FAN" "${raw_value}RPM" "fan1"
      elif [[ -n $gpu_pwm_path && -n $gpu_pwm_max_path ]] && read_number_into pwm "$gpu_pwm_path" && read_number_into pwm_max "$gpu_pwm_max_path" && (( pwm_max > 0 )); then
        percent=$(((pwm * 100 + pwm_max / 2) / pwm_max)); add_metric "gpu.fan" "gpu" "$label_gpu_fan" "FAN" "${percent}%" "pwm1"
      fi
    fi
    if metric_requested "gpu.frequency" "$collect_all" && [[ -n $gpu_frequency_path ]]; then
      read_number_into raw_value "$gpu_frequency_path" && add_metric "gpu.frequency" "gpu" "$label_gpu_frequency" "GPU↯" "$(((raw_value + 500000) / 1000000))MHz" "sclk"
    fi
    if metric_requested "gpu.vram" "$collect_all" && [[ -n $gpu_vram_total_path && -n $gpu_vram_used_path ]] \
        && read_number_into vram_total "$gpu_vram_total_path" && read_number_into vram_used "$gpu_vram_used_path" && (( vram_total > 0 )); then
      percent=$((vram_used * 100 / vram_total)); format_gib_into used_text "$vram_used"; format_gib_into total_text "$vram_total"
      add_metric "gpu.vram" "gpu" "$label_vram" "VRAM" "${percent}%" "$used_text / $total_text"
    fi
  elif [[ $gpu_vendor == nvidia && $nvidia_smi_available == true ]] && { [[ $collect_all == true ]] || nvidia_metrics_requested; }; then
    [[ $watch_mode == true && -z $nvidia_stream_pid ]] && start_nvidia_stream
    collect_nvidia_metrics
  fi
}

emit_snapshot() {
  local complete=$1 metrics_json="" dependencies_json="" payload escaped_language escaped_vendor escaped_tool escaped_name
  if (( ${#metrics[@]} > 0 )); then printf -v metrics_json '%s,' "${metrics[@]}"; metrics_json=${metrics_json%,}; fi
  if (( ${#dependencies[@]} > 0 )); then printf -v dependencies_json '%s,' "${dependencies[@]}"; dependencies_json=${dependencies_json%,}; fi
  json_escape_into escaped_language "$language"; json_escape_into escaped_vendor "$gpu_vendor"
  json_escape_into escaped_tool "$gpu_tool"; json_escape_into escaped_name "$gpu_name"
  local dependency_field="" sampled_csv="" sampled_id
  if [[ $collect_all == true ]]; then
    for sampled_id in "${!known_metric_ids[@]}"; do sampled_csv+="${sampled_csv:+,}$sampled_id"; done
  else
    for sampled_id in "${!enabled_metrics[@]}"; do sampled_csv+="${sampled_csv:+,}$sampled_id"; done
  fi
  if [[ $complete == true ]]; then dependency_field=",\"dependencies\":[$dependencies_json]"; fi
  printf -v payload '{"version":1,"complete":%s,"language":"%s","gpuVendor":"%s","gpuTool":"%s","gpuName":"%s","sampled":"%s","metrics":[%s]%s}' \
    "$complete" "$escaped_language" "$escaped_vendor" "$escaped_tool" "$escaped_name" "$sampled_csv" "$metrics_json" "$dependency_field"
  if (( ${#payload} > MAX_OUTPUT_BYTES )); then printf 'collector output exceeds %d bytes\n' "$MAX_OUTPUT_BYTES" >&2; return 70; fi
  printf '%s\n' "$payload"
}

declare -A known_metric_ids=()
emit_complete=true
disk_sample_second=-30; disk_cached_value=""; disk_cached_detail=""

# Bounded, allowlisted control messages; never evaluate command text.
apply_control() {
  local message=$1 command next_interval next_csv next_open extra id old_interval=$interval_ms
  read -r command next_interval next_csv next_open extra <<< "$message"
  if [[ $command == RESCAN && -z ${next_interval:-} ]]; then
    needs_rescan=true; last_detection_second=$((SECONDS - 30)); return
  fi
  [[ $command == CONFIG && $next_interval =~ ^[0-9]{4,5}$ && $next_open =~ ^[01]$ && -z ${extra:-} ]] || return
  (( next_interval >= 1000 && next_interval <= 30000 )) || return
  [[ $next_csv == - || $next_csv =~ ^[a-z.,]+$ ]] || return
  enabled_metrics=(); enabled_metrics_csv=""; enabled_filter_set=true
  local -a ids=()
  IFS=, read -r -a ids <<< "$next_csv"
  for id in "${ids[@]}"; do
    case "$id" in
      cpu.load|cpu.temp|cpu.power|cpu.frequency|memory.ram|memory.swap|disk.root|gpu.load|gpu.temp|gpu.edge|gpu.hotspot|gpu.memory_temp|gpu.power|gpu.fan|gpu.frequency|gpu.vram)
        [[ -n ${enabled_metrics[$id]+x} ]] && continue
        enabled_metrics[$id]=1
        enabled_metrics_csv+="${enabled_metrics_csv:+,}$id"
        ;;
    esac
  done
  panel_open=false; [[ $next_open == 1 ]] && panel_open=true
  interval_ms=$next_interval
  printf -v interval_delay '%d.%03d' "$((interval_ms / 1000))" "$((interval_ms % 1000))"
  (( old_interval != interval_ms )) && stop_nvidia_stream
  stop_unused_nvidia_stream
  return 0
}

previous_cpu_total=""; previous_cpu_idle=""
read_cpu_totals_into previous_cpu_total previous_cpu_idle || true
discover_hardware
start_nvidia_stream
collect_snapshot true
emit_snapshot true || exit $?
stop_unused_nvidia_stream

if [[ $watch_mode == true ]]; then
  while true; do
    if [[ $control_mode == true ]]; then
      message=""
      if IFS= read -r -t "$interval_delay" -n 1024 message; then
        apply_control "$message"
      elif [[ $? -le 128 ]]; then
        exit 0
      fi
    else
      sleep "$interval_delay"
    fi
    complete=false
    if { [[ $needs_rescan == true ]] && (( SECONDS - last_detection_second >= 30 )); } || (( SECONDS - last_detection_second >= rescan_interval_sec )); then
      stop_nvidia_stream; discover_hardware; start_nvidia_stream; complete=true
    fi
    emit_complete=$complete
    sample_all=$complete
    [[ $panel_open == true || $enabled_filter_set == false ]] && sample_all=true
    collect_snapshot "$sample_all"
    emit_snapshot "$complete" || exit $?
    stop_unused_nvidia_stream
  done
fi
